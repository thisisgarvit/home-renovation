# Copy to .env.local for local development, or paste into Vercel → Project → Settings → Environment Variables.
# With nothing set, the app runs in demo mode: data stays in the browser, with a fictional sample household.

# ---- App (browser) ----
# Force demo mode even if Supabase keys are present (use this for the public demo deployment).
VITE_DEMO=
# Comma-separated names shown on "Who is using the app?" (default: Anil,Sunita,Rohan)
VITE_FAMILY=
# Optional: comma-separated rooms (default: Living room,Bathroom,Mother's room,Study room,Main bedroom,Balcony,Kitchen). "Whole house" is always added.
VITE_ROOMS=
# Supabase → Project settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server (Vercel functions only; never prefix these with VITE_) ----
# Must match the code set in supabase/schema.sql (private.app_config). Everyone types it once per phone.
FAMILY_CODE=
# Used to store photos in Supabase Storage when Google Drive isn't connected.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google Drive (optional). Create an OAuth client, then visit /api/google/start once. See docs/SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
